DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1

# production hosts several subprojects behind one reverse proxy, each under
# its own URL prefix (this project is normally served at /pedagogy).
# Set to "local" for local testing (python manage.py runserver) to drop
# the prefix; leave as "production" for the real deployment.
DEPLOY_ENV=production

DB_ENGINE=django.db.backends.postgresql
DB_NAME=kfxbpedc_pedagogy_db
